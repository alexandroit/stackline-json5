{
    "root": true,
    "extends": [
        "standard",
        "plugin:n/recommended"
    ],
    "rules": {
        "array-bracket-spacing": [
            "error",
            "never"
        ],
        "arrow-parens": [
            "error",
            "as-needed"
        ],
        "comma-dangle": [
            "error",
            {
                "arrays": "always-multiline",
                "objects": "always-multiline",
                "imports": "always-multiline",
                "exports": "always-multiline",
                "functions": "never"
            }
        ],
        "indent": [
            "error",
            4
        ],
        "no-process-exit": "off",
        "object-curly-spacing": [
            "error",
            "never"
        ],
        "n/no-process-exit": "off",
        "prefer-const": "off",
        "quotes": [
            "error",
            "single",
            {
                "avoidEscape": true
            }
        ]
    },
    "overrides": [
        {
            "files": [
                "lib/register.js"
            ],
            "rules": {
                "n/no-deprecated-api": "off"
            }
        },
        {
            "files": [
                "lib/unicode.js"
            ],
            "rules": {
                "no-misleading-character-class": "off"
            }
        },
        {
            "files": [
                "test/*.js"
            ],
            "rules": {
                "quotes": "off",
                "quote-props": "off",
                "no-loss-of-precision": "off"
            }
        }
    ],
    "ignorePatterns": [
        "scripts/",
        "artifact/",
        ".tap/"
    ],
    "plugins": [
        "node"
    ]
}
